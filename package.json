{
  "name": "@docflow/studio-desktop",
  "version": "1.5.0",
  "description": "DocFlow Studio Desktop — Markdown authoring & publication-grade export, native on Windows & Linux.",
  "private": true,
  "license": "MIT",
  "author": "DocFlow",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node scripts/verify-build.mjs",
    "package": "npm run build && npm run verify && electron-builder --win --x64 && npm run checksums",
    "package:linux": "npm run build && npm run verify && electron-builder --linux --x64 && npm run checksums",
    "checksums": "node scripts/checksums.mjs",
    "icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-icons.ps1"
  },
  "dependencies": {
    "docx": "^9.0.0",
    "dompurify": "^3.2.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.460.0",
    "marked": "^15.0.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.18"
  },
  "allowScripts": {
    "electron@33.2.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "core-js@3.51.0": true
  }
}
